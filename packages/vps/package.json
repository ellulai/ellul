    "@ellul.ai/ts-config": "workspace:*",
    "@simplewebauthn/browser": "^11.0.0",
    "@types/better-sqlite3": "^7.6.5",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "4.1.5",
    "better-sqlite3": "^11.0.0",
    "isolated-vm": "6.1.2",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.17",
    "ws": "^8.18.0"
  }
