  "scripts": {
    "prebuild": "node src/services/auth/sovereign-shield/pqc-browser-bundle.build.mjs && node src/services/auth/sovereign-shield/pop-client-bundle.build.mjs && pnpm run build:scaffold-manifest",
    "build": "tsup",
    "postbuild": "node scripts/prebundle-services.mjs",
    "build:scaffold-manifest": "tsx src/templates/scaffold/scripts/build-tree-manifest.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
