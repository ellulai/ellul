{
  "name": "@ellul.ai/vps",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./pinned-versions": {
      "types": "./dist/pinned-versions.d.ts",
      "default": "./dist/pinned-versions.js"
