{
  "name": "@ellul.ai/vps-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./code-browser": {
      "types": "./code-browser.d.ts",
      "default": "./dist/code-browser.js"
    },
    "./chat": {
      "types": "./chat.d.ts",
      "default": "./dist/chat.js"
    }
  },
  "scripts": {
    "build": "pnpm build:chat && pnpm build:code-browser && node scripts/wrap-html.js",
    "build:chat": "vite build --config vite.chat.config.ts",
    "build:code-browser": "vite build --config vite.code-browser.config.ts",
    "dev:chat": "vite --config vite.chat.config.ts",
    "dev:code-browser": "vite --config vite.code-browser.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@ellul.ai/chat-actions": "workspace:*",
    "@ellul.ai/i18n-consts": "workspace:*",
    "@ellul.ai/i18n-messages": "workspace:*",
    "@ellul.ai/types": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@legendapp/list": "3.0.0-beta.44",
    "@lexical/react": "^0.41.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-pacer": "^0.19.4",
    "@tanstack/react-query": "^5.90.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.45",
    "lexical": "^0.41.0",
    "lucide-react": "^0.469.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "use-intl": "^3.26.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@ellul.ai/ts-config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^4.0.17"
  }
}
