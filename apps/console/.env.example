# ===========================================
# ellul.ai Console - Environment Variables
# ===========================================

# ── Demo / Mock Mode ──────────────────────────────────────────────
# Run the full console UI with realistic fake data — no backend, no
# VPS, no database needed. Perfect for contributors and UI work.
#
#   NEXT_PUBLIC_MOCK_MODE=true npm run dev
#
# NEXT_PUBLIC_MOCK_MODE=true

# ── API URL ───────────────────────────────────────────────────────
# Backend API URL (must be accessible from browser).
# Not needed when NEXT_PUBLIC_MOCK_MODE=true.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Platform domain configuration (for self-hosted deployments)
# NEXT_PUBLIC_PLATFORM_DOMAIN=ellul.ai
# NEXT_PUBLIC_APP_DOMAIN=ellul.app
# NEXT_PUBLIC_WEBAUTHN_RP_ID=ellul.ai
