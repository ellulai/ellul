{
  "identifier": "android",
  "description": "Android-only capabilities — proot BYOS workspace commands and localhost remote origin for shield/core when WebView loads from localhost:8443",
  "windows": ["main"],
  "remote": {
    "urls": ["https://localhost:8443/*"]
  },
  "platforms": ["android"],
  "permissions": [
    "default",
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "shell:allow-open",
    "notification:default",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "native-auth:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "shield:allow-shield-check-session",
    "shield:allow-shield-set-session",
    "shield:allow-shield-clear-session",
    "shield:allow-shield-login-options",
    "shield:allow-shield-login-verify",
    "shield:allow-shield-passkey-login",
