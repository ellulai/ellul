{
  "identifier": "default",
  "description": "Default capabilities for ellul.ai",
  "windows": ["main"],
  "remote": {
    "urls": ["https://console.ellul.ai/*"]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "shell:allow-open",
    "notification:default",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "native-auth:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "shield:allow-shield-check-session",
    "shield:allow-shield-set-session",
    "shield:allow-shield-clear-session",
    "shield:allow-shield-login-options",
    "shield:allow-shield-login-verify",
    "shield:allow-shield-passkey-login",
    "shield:allow-shield-passkey-register",
    "shield:allow-shield-native-credential-create",
    "shield:allow-shield-native-credential-get",
    "shield:allow-shield-open-auth-sheet",
    "shield:allow-shield-web-auth-login",
    "shield:allow-shield-web-auth-register",
    "shield:allow-shield-register-options",
    "shield:allow-shield-register-verify",
    "shield:allow-shield-session-info",
    "shield:allow-shield-logout",
    "shield:allow-shield-session-keepalive",
    "shield:allow-shield-get-code-session",
    "shield:allow-shield-get-code-token",
    "shield:allow-shield-get-agent-token",
    "shield:allow-shield-get-terminal-token",
    "shield:allow-shield-get-preview-token",
    "shield:allow-shield-get-exchange-code",
    "shield:allow-shield-permission-list-pending",
    "shield:allow-shield-permission-get",
    "shield:allow-shield-permission-history",
    "shield:allow-shield-permission-mark-seen",
    "shield:allow-shield-gate-list-active",
    "shield:allow-shield-gate-request",
    "shield:allow-shield-gate-respond",
    "shield:allow-shield-gate-revoke",
    "shield:allow-shield-gate-set-permission",
    "shield:allow-shield-context-mode-get",
    "shield:allow-shield-context-mode-set",
    "shield:allow-shield-tool-permission-set",
    "shield:allow-shield-tool-permission-reset",
    "shield:allow-shield-operator-status",
    "shield:allow-shield-operator-bind",
    "shield:allow-shield-operator-sign",
    "shield:allow-shield-operator-sign-intent",
    "shield:allow-shield-operator-clear",
    "shield:allow-shield-intent-nonce",
    "shield:allow-shield-create-signed-ws-url",
    "shield:allow-shield-fetch",
    "shield:allow-shield-js-log",
    "proot:allow-proot-start",
    "proot:allow-proot-stop",
    "proot:allow-proot-status",
    "proot:allow-proot-health",
    "proot:allow-proot-setup-status",
    "proot:allow-proot-setup-start",
    "proot:allow-proot-switch-to-local",
    "proot:allow-proot-tunnel-start",
    "proot:allow-proot-tunnel-stop",
    "proot:allow-proot-tunnel-status",
    "proot:allow-proot-update-check",
    "proot:allow-proot-update-apply",
    "proot:allow-proot-update-cancel",
    "proot:allow-proot-update-get-settings",
    "proot:allow-proot-update-set-settings",
    "proot:allow-proot-migration-export-file"
  ]
}
