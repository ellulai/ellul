{
  "identifier": "desktop",
  "description": "Desktop-only capabilities (global shortcuts, tray)",
  "windows": ["main"],
  "remote": {
    "urls": ["https://console.ellul.ai/*"]
  },
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
