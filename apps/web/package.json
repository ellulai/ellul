{
  "name": "@ellul.ai/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lighthouse": "NEXT_PUBLIC_WEB_URL=http://localhost:3002 next build && lhci autorun --config=./lighthouserc.json",
    "seo:audit": "tsx --tsconfig scripts/tsconfig.json scripts/seo-audit.ts",
    "content:audit": "tsx scripts/content-audit.ts",
    "rss:validate": "node scripts/rss-validate.mjs",
    "cf:preview": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare populateCache local && npx opennextjs-cloudflare preview",
    "cf:deploy": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare populateCache local && npx wrangler deploy --config wrangler.jsonc",
    "cf:deploy:staging": "dotenv -e .env.staging -- npx opennextjs-cloudflare build && npx opennextjs-cloudflare populateCache local && npx wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@ellul.ai/ui": "workspace:*",
    "geist": "^1.5.1",
    "gray-matter": "^4.0.3",
    "next": "^15.1.3",
    "next-intl": "^3.26.5",
    "next-mdx-remote": "^5.0.0",
    "posthog-js": "^1.205.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.1",
    "@ellul.ai/i18n": "workspace:*",
    "@ellul.ai/i18n-consts": "workspace:*",
    "@ellul.ai/i18n-messages": "workspace:*",
    "@ellul.ai/marketing-mdx": "workspace:*"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.14.8",
    "@ellul.ai/ts-config": "workspace:*",
    "@lhci/cli": "^0.14.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "fast-xml-parser": "^5.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.58.0"
  }
}
